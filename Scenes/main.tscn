[sub_resource type="GDScript" id="GDScript_21xkr"]
script/source = "extends Node2D

@onready var enemy_spawner: EnemySpawner = $EnemySpawner


signal enemy_spawn_triggered
@onready var game_over: Label = $\"CanvasLayer/Control/Game Over\"


func _ready() -> void:
	connect_enemy_spawners()


func connect_enemy_spawners() -> void:
	var spawners: Array[Node] = (
		get_tree().get_nodes_in_group(
			\"EnemySpawner\"
		)
	)

	for spawner in spawners:
		if not spawner is EnemySpawner:
			continue

		enemy_spawn_triggered.connect(
			spawner.activate
		)


func trigger_enemy_spawn() -> void:
	enemy_spawn_triggered.emit()


func _on_player_died() -> void:
	game_over.visible = true
	pass # Replace with function body.

func _process(delta: float) -> void:
	if game_over and Input.is_action_just_pressed(\"restart\"):
		get_tree().reload_current_scene()
		
"

